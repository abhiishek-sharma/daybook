# Copy to .env.local and change these before using the app for real.
# All values are optional; the defaults below are for local development only.

# Login (single user)
OBSERVATORY_USER="admin"
OBSERVATORY_PASSWORD="changeme"

# Session cookie signing secret: set a long random string
SESSION_SECRET="change-me-to-a-long-random-string"

# API port (the Vite dev server proxies /api to it)
PORT=3001
